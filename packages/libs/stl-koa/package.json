{
  "name": "@mtth/stl-koa",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://forge.mtth.dev/mtth/sdk.ts.git"
  },
  "description": "Koa utilities",
  "keywords": [
    "stl",
    "apollo",
    "koa"
  ],
  "author": "Matthieu Monsch <mtth@apache.org>",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "lib/"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./errors": "./lib/index.errors.js"
  },
  "scripts": {
    "build": "tsc -b src test",
    "clean": "rm -rf lib node_modules out $(find test -name '*.gen' -o -name '*.gen.*')",
    "fix": "prettier --write",
    "prepare": "pnpm run build && inlinable r",
    "test": "vitest",
    "watch": "tsc -b -w src test"
  },
  "dependencies": {
    "@koa/router": "^15.3.0",
    "@mtth/stl-errors": "workspace:*",
    "@mtth/stl-resilience": "workspace:*",
    "@mtth/stl-settings": "workspace:*",
    "@mtth/stl-telemetry": "workspace:*",
    "@mtth/stl-utils": "workspace:*",
    "@opentelemetry/core": "^2.5.1",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "ajv": "^8.18.0",
    "get-port": "^7.1.0",
    "koa": "^3.1.1",
    "koa-body": "^7.0.1",
    "koa-compose": "^4.1.0",
    "koa-compress": "^5.2.0",
    "luxon": "^3.7.2",
    "openapi-schema-validator": "^12.1.3",
    "rate-limiter-flexible": "^9.1.1",
    "raw-body": "^3.0.2",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "~1.9.0"
  },
  "devDependencies": {
    "@mtth/inlinable": "workspace:*",
    "@mtth/stl-bootstrap": "workspace:*",
    "@opentelemetry/api": "~1.9.0",
    "@types/koa": "^3.0.1",
    "@types/koa-compose": "^3.2.9",
    "@types/koa-compress": "^4.0.7",
    "@types/koa__router": "^12.0.5",
    "@types/luxon": "^3.7.1",
    "form-data": "^4.0.5",
    "openapi-types": "^12.1.3",
    "supertest": "^7.2.2"
  },
  "typedocMain": "src/index.ts"
}
