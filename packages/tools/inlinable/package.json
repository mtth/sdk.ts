{
  "name": "@mtth/inlinable",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://forge.mtth.dev/mtth/sdk.ts.git"
  },
  "description": "JavaScript code inlining utilities",
  "keywords": [
    "inline"
  ],
  "author": "Matthieu Monsch <mtth@apache.org>",
  "license": "MIT",
  "type": "module",
  "bin": "bin/inlinable.mjs",
  "files": [
    "bin/",
    "lib/"
  ],
  "exports": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "tsc -b src test",
    "clean": "rm -rf lib node_modules out $(find test -name '*.actual.*')",
    "fix": "prettier --write",
    "prepare": "pnpm run build",
    "test": "vitest",
    "watch": "tsc -b -w src test"
  },
  "dependencies": {
    "@mtth/inlinable-runtime": "workspace:*",
    "@mtth/stl-errors": "workspace:*",
    "@mtth/stl-utils": "workspace:*",
    "acorn": "^8.15.0",
    "ast-types": "^0.14.2",
    "commander": "^12.1.0",
    "glob": "^10.4.5",
    "ora": "^8.2.0",
    "recast": "^0.23.11"
  },
  "devDependencies": {
    "ts-essentials": "^10.1.1"
  }
}
